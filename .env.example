# Frontend runtime endpoints (used by Vite)
VITE_BRIDGE_HOST=127.0.0.1
VITE_TELEMETRY_PORT=9001
VITE_ROUTE_PORT=9002
VITE_SOLVER_PORT=9003

# Bridge listeners (used by ws-bridge.cjs and telemetry-server.cjs)
# Use BRIDGE_BIND_HOST=0.0.0.0 inside Docker.
BRIDGE_BIND_HOST=127.0.0.1
TELEMETRY_PORT=9001
ROUTE_PORT=9002
SOLVER_PORT=9003
WEB_STATE_DIR=./web_state
# Windows: ./native/build/gpo_route_solver.exe
# Linux/Docker: ./native/build/gpo_route_solver
SOLVER_PATH=./native/build/gpo_route_solver.exe
MOCK_TELEMETRY=0
